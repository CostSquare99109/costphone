# ---- captura de pantalla ----
cmd_ocr() {
    # OCR de la captura: localiza texto que el árbol de accesibilidad no expone
    # (canvas, WebView, botones custom de MIUI). Devuelve el centro en píxeles.
    #   amctl find "texto" [conf] [--region x,y,w,h]
    local needle="${1:-}" fresh="" minconf=55 region=""
    [[ -z "$needle" ]] && { echo 'uso: amctl find "texto" [conf] [--region x,y,w,h]' >&2; return 2; }
    shift || true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --region) region="${2:-}"; shift 2 ;;
            --region=*) region="${1#*=}"; shift ;;
            --conf) minconf="${2:-55}"; shift 2 ;;
            ''|*[!0-9]*) shift ;;
            *) minconf="$1"; shift ;;
        esac
    done
    command -v tesseract >/dev/null 2>&1 || {
        echo "tesseract no está instalado (pkg install tesseract)" >&2; return 1; }

    local shot; shot=$(shot_file)
    # captura fresca si no hay o es vieja (>15 s)
    local age=999
    [[ -f "$shot" ]] && age=$(( $(date +%s) - $(stat -c%Y "$shot" 2>/dev/null || echo 0) ))
    if [[ "$age" -gt 15 ]]; then
        cmd_shot >/dev/null 2>&1 || { echo "no se pudo capturar la pantalla" >&2; return 1; }
    fi
    [[ -f "$shot" ]] || { echo "no hay captura: $shot" >&2; return 1; }

    # Recorte de la región de interés: el OCR sobre una franja es 10x más
    # rápido que sobre la pantalla entera (17 s -> 2 s en un fotograma de video).
    local work="$shot" factor=1 ox=0 oy=0
    if command -v python3 >/dev/null 2>&1; then
        local tmp="${TMPDIR:-/tmp}/amctl-ocr-$$.jpg" info
        if [[ -n "$region" ]]; then
            info=$(python3 - "$shot" "$tmp" "$region" <<'PYEOF' 2>/dev/null
import sys
from PIL import Image
im = Image.open(sys.argv[1])
x, y, w, h = [int(v) for v in sys.argv[3].split(",")]
im = im.crop((x, y, min(im.width, x + w), min(im.height, y + h)))
im.save(sys.argv[2], quality=90)
print(im.width, im.height, x, y)
PYEOF
)
        else
            info=$(python3 - "$shot" "$tmp" <<'PYEOF' 2>/dev/null
import sys
from PIL import Image
im = Image.open(sys.argv[1])
w0 = im.width
if w0 > 700:
    im = im.resize((700, max(1, int(im.height * 700 / w0))))
im.save(sys.argv[2], quality=85)
print(im.width, im.height, 0, 0)
PYEOF
)
        fi
        if [[ -n "$info" ]]; then
            local nw nh; nw=$(echo "$info" | awk '{print $1}'); nh=$(echo "$info" | awk '{print $2}')
            ox=$(echo "$info" | awk '{print $3}'); oy=$(echo "$info" | awk '{print $4}')
            work="$tmp"
            if [[ -n "$region" ]]; then
                factor=1   # el recorte ya está en píxeles reales: solo desplazamiento
            else
                local ow; ow=$(python3 -c "
from PIL import Image; print(Image.open('$shot').width)" 2>/dev/null || echo 1080)
                factor=$(awk "BEGIN{print ($ow>0)?$ow/$nw:1}")
            fi
        fi
    fi

    local n; n=$(printf '%s' "$needle" | tr 'A-ZÁÉÍÓÚÑ' 'a-záéíóúñ')
    local out; out=$(tesseract "$work" stdout --psm 11 tsv 2>/dev/null | awk -F'\t' -v n="$n" -v mc="$minconf" -v k="$factor" -v ox="$ox" -v oy="$oy" '
        NR>1 && $12!="" && $11!="" && $11+0>=mc {
            t=tolower($12);
            if (index(t,n)>0) {
                cx=int(($7+int($9/2))*k+ox); cy=int(($8+int($10/2))*k+oy);
                printf "%s\t%d\t%d\t%d\t%d\t%s\n", $12, cx, cy, $7, $8, $11;
            }
        }')
    [[ "$work" != "$shot" ]] && rm -f "$work"
    if [[ -z "$out" ]]; then
        echo "no se encontró '$needle' en la captura (conf>=$minconf)"
        return 1
    fi
    echo "$out" | while IFS=$'\t' read -r txt cx cy l t conf; do
        echo "texto '$txt' en ($cx,$cy)  conf=$conf  ->  amctl tap $cx $cy"
    done
    return 0
}

cmd_shot() {
    local out="" scale="" fmt="jpg"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --scale) scale="${2:-}"; shift 2 ;;
            --scale=*) scale="${1#*=}"; shift ;;
            --png) fmt="png"; shift ;;
            *) [[ -z "$out" ]] && out="$1"; shift ;;
        esac
    done
    if [[ -z "$out" ]]; then
        if [[ "$fmt" == "png" ]]; then
            if [[ "$DISPLAY_ID" == "0" ]]; then out="/sdcard/Download/accessdroid-shot.png"
            else out="/sdcard/Download/accessdroid-shot-d$DISPLAY_ID.png"; fi
        else
            out=$(shot_file)
        fi
    fi

    CP_ARGS=""
    cp_arg i displayId "$DISPLAY_ID"
    [[ -n "$scale" ]] && cp_arg f scale "$scale"
    [[ "$fmt" == "png" ]] && cp_arg s format png
    if cp_call $ACTION_SCREENDUMP "$(cp_encode_args)"; then
        if [[ "$CP_CODE" == "ok" && -n "$CP_B64" ]]; then
            printf '%s' "$CP_B64" | base64 -d > "$out" 2>/dev/null
            # tamaño sin stat (un exec): base64 -> 3 bytes cada 4 caracteres
            local raw_len=${#CP_B64} pad=0
            [[ "$CP_B64" == *"==" ]] && pad=2 || { [[ "$CP_B64" == *"="* ]] && pad=1; }
            echo "captura: $out ($(( raw_len * 3 / 4 - pad )) bytes)"
            return 0
        fi
        [[ -n "$CP_TEXT" ]] && echo "$CP_TEXT" >&2
        return 1
    fi
    cp_no_channel
    return 1
}

# ---- tocar coordenadas vistas en una captura ----
cmd_tapshot() {
    local png; png=$(shot_file)
    [[ ! -f "$png" ]] && png="/sdcard/Download/accessdroid-shot.png"
    [[ ! -f "$png" ]] && { echo "no hay screenshot: ejecuta primero: amctl see" >&2; return 1; }
    local dim pw ph
    dim=$(python3 - "$png" <<'PY'
import struct, sys
data = open(sys.argv[1], "rb").read(4096)
if data[:8] == b"\x89PNG\r\n\x1a\n":
    w, h = struct.unpack(">II", data[16:24])
else:
    # JPEG: buscar el marcador SOF
    w = h = 0
    i = 2
    while i < len(data) - 9:
        if data[i] != 0xFF:
            i += 1; continue
        m = data[i+1]
        if m in (0xC0,0xC1,0xC2,0xC3,0xC5,0xC6,0xC7,0xC9,0xCA,0xCB,0xCD,0xCE,0xCF):
            h = struct.unpack(">H", data[i+5:i+7])[0]
            w = struct.unpack(">H", data[i+7:i+9])[0]
            break
        i += 2 + struct.unpack(">H", data[i+2:i+4])[0]
print(w, h)
PY
) || { echo "no pude leer la imagen" >&2; return 1; }
    read -r pw ph <<<"$dim"
    local x="${1:-}" y="${2:-}" wsi="${3:-}" hsi="${4:-}"
    [[ -z "$x" || -z "$y" ]] && { echo "uso: amctl tapshot X Y [W H]" >&2; return 2; }
    local sx=1.0 sy=1.0
    if [[ -n "$wsi" && "$wsi" != 0 ]]; then
        if [[ -z "$hsi" || "$hsi" == 0 ]]; then
            sx=$(awk "BEGIN{print $pw/$wsi}"); sy=$sx
        else
            sx=$(awk "BEGIN{print $pw/$wsi}"); sy=$(awk "BEGIN{print $ph/$hsi}")
        fi
    fi
    local tx ty
    read -r tx ty < <(awk "BEGIN{print int($x*$sx+.5), int($y*$sy+.5)}")
    cmd_tap "$tx" "$ty" 80
    echo "tapshot ($x,$y)x(${sx}:${sy}) -> ${pw}x${ph} -> tap ($tx,$ty)"
}

# ---- pantalla virtual ----
OVERLAY_FLAGS_RE='^(secure|own_content_only|should_show_system_decorations|gravity_top_left|gravity_top_right|gravity_bottom_left|gravity_bottom_right|mirror)$'

normalize_display_flags() {
    local out="" tok
    for tok in ${*//,/ }; do
        tok="${tok,,}"
        [[ -z "$tok" ]] && continue
        if [[ ! "$tok" =~ $OVERLAY_FLAGS_RE ]]; then
            echo "✗ flag no soportado: '$tok'" >&2
            echo "  válidos: secure, own_content_only, should_show_system_decorations," >&2
            echo "           gravity_top_left|top_right|bottom_left|bottom_right, mirror" >&2
            return 2
        fi
        case ",$out," in *",$tok,"*) continue ;; esac
        out="${out:+$out,}$tok"
    done
    printf '%s' "$out"
}

print_displays() {
    local line id nm sz dp st wn first=1
    while IFS= read -r line; do
        case "$line" in
            error=*) echo "✗ ${line#error=}" ;;
            display=*) first=0
                id=${line#display=};      id=${id%% *}
                nm=${line#*name=};        nm=${nm%% *}
                sz=${line#*size=};        sz=${sz%% *}
                dp=${line#*dpi=};         dp=${dp%% *}
                st=${line#*state=};       st=${st%% *}
                wn=${line#*wins=}
                printf "  d%-3s %-14s %-10s %-5s %-4s ventanas:%s\n" "$id" "$nm" "$sz" "$dp" "$st" "$wn" ;;
            overlay=*) [[ $first == 1 ]] || echo "  ajuste overlay_display_devices: ${line#overlay=}" ;;
        esac
    done
}

cmd_display() {
    local op="${1:-status}"
    local w="${2:-1080}" h="${3:-1920}" dpi="${4:-320}" flags="${5:-}"

    if [[ "$op" == "on" ]]; then
        flags="$(normalize_display_flags "${@:5}")" || return 2
    fi

    CP_ARGS=""
    cp_arg s op "$op"
    cp_arg i width "$w"
    cp_arg i height "$h"
    cp_arg i density "$dpi"
    [[ -n "$flags" ]] && cp_arg s flags "$flags"
    if cp_call $ACTION_DISPLAY "$(cp_encode_args)"; then
        print_displays <<<"$CP_TEXT"
        [[ "$CP_CODE" == "ok" ]] && return 0
        return 1
    fi
    cp_no_channel
    return 1
}

# ---- ventana flotante (flujo MIUI: recents -> long-press -> menu) ----
cmd_float() {
    local target="${1:-}"
    local pkg="${2:-}"
    [[ -z "$target" ]] && { echo "uso: amctl float <texto-tarjeta-en-recents> [pkg]" >&2; return 2; }
    shift 2 || true
    local extra="${1:-}"
    local t="${target,,}"
    cmd_recents; sleep 1
    local out row
    out=$(cmd_snap 2>/dev/null)
    row=$(printf '%s\n' "$out" | awk -v t="$t" 'tolower($0) ~ t && /^@p[0-9]+ \[Frame/ {print; exit}')
    if [[ -z "$row" && -n "$pkg" ]]; then
        cmd_launch "$pkg" >/dev/null 2>&1; sleep 3
        cmd_recents; sleep 1
        out=$(cmd_snap 2>/dev/null)
        row=$(printf '%s\n' "$out" | awk -v t="$t" 'tolower($0) ~ t && /^@p[0-9]+ \[Frame/ {print; exit}')
    fi
    [[ -z "$row" ]] && { echo "amctl float: no encontré la tarjeta '$target' en recents" >&2; return 1; }
    read -r cx cy <<<"$(printf '%s' "$row" | sed -E 's/.*\(([0-9]+),([0-9]+)\).*/\1 \2/')"
    cmd_longpress "$cx" "$cy" 700 >/dev/null; sleep 1
    out=$(cmd_snap 2>/dev/null)
    local want="menu_item_small_window"
    [[ "$extra" == 'split' ]] && want="menu_item_multi_window"
    row=$(printf '%s\n' "$out" | awk -v w="$want" '$0 ~ w {print; exit}')
    [[ -z "$row" ]] && row=$(printf '%s\n' "$out" | awk 'tolower($0) ~ /ventanas flotantes/ {print; exit}')
    [[ -z "$row" ]] && { echo "amctl float: la app no ofrece ventana flotante" >&2; return 1; }
    read -r cx cy <<<"$(printf '%s' "$row" | sed -E 's/.*\(([0-9]+),([0-9]+)\).*/\1 \2/')"
    cmd_tap "$cx" "$cy" 80
    echo "float: $target -> ventana flotante"
}

# ---- despertar el canal (pre-calentar) ----
# Abre el socket, hace un ping y deja el puerto cacheado: la primera orden
# real ya no paga la búsqueda de puerto.
cmd_warmup() {
    CP_ARGS=""
    if cp_call $ACTION_PING ""; then
        echo "canal listo: $CP_HOST:$CP_PORT (${CP_TEXT:-pong})"
        return 0
    fi
    echo "canal rápido: NO disponible" >&2
    return 1
}

# ---- diagnóstico del canal ----
cmd_status() {
    CP_ARGS=""
    if cp_call $ACTION_PING ""; then
        echo "canal rápido: OK (127.0.0.1, respuesta: ${CP_TEXT:-sin cuerpo})"
        CP_ARGS=""; cp_arg i display "$DISPLAY_ID"
        if cp_call $ACTION_GET_SNAPSHOT "$(cp_encode_args)"; then
            echo "display $DISPLAY_ID: ${CP_TEXT%%$'\n'*}"
        fi
        return 0
    fi
    echo "canal rápido: NO disponible"
    detect_transport
    echo "transporte legacy: $TRANSPORT  (am clásico = cada orden 1-5s)"
    echo "→ instala la app v1.3+ y reactiva Ajustes → Accesibilidad → CostPhone"
    return 1
}

# ---- activar el servicio de accesibilidad (tras una actualización) ----
cmd_enable() {
