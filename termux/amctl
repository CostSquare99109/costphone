#!/data/data/com.termux/files/usr/bin/bash
#==============================================================================
# amctl - App control toolkit for Termux
# Drives the AccessDroid AccessibilityService (simulates clicks, scrolls,
# type-into-field, UI-tree inspection) + am transport for app lifecycle.
#
# Prerequisites:
#   1. AccessDroid APK built & installed (see bin/accessdroid/build.sh)
#   2. Settings -> Accessibility -> AccessDroid  =>  ON
#
# Transport (auto-detected):
#   "socket": termux-am AM socket (Termux app v0.119+). Full functionality.
#   "am":     classic TermuxAm 'am' command (works on stable Termux v0.118.x).
#             Everything works except pm-based commands, which need the socket:
#             list / find / stop / info / perms / grant / revoke / clear.
#
# Usage: amctl <command> [args...]
#   session-start            Abre la sesión rish persistente (FIFO) — solo tú
#   session-stop             Cierra la sesión rish (rish + tail + FIFO)
#   status                   Backend activo + si la sesión responde
#   list     [query]            List 3rd-party apps (socket only)
#   find     <name>             Search apps by label (socket only)
#   launch   <app|pkg>          Launch an app (use package name without socket)
#   stop     <app|pkg>          Force-stop an app (socket only)
#   info     <app|pkg>          Package info (socket only)
#   perms    <app|pkg>          List app permissions (socket only)
#   grant    <app|pkg> <perm>   Grant a permission (socket only)
#   revoke   <app|pkg> <perm>   Revoke a permission (socket only)
#   clear    <app|pkg>          Clear app data/cache (socket only)
#   tree                         Dump current UI tree -> /sdcard/Download/accessdroid-tree.txt
#   snap     [-a] [--filter T]  Snapshot con refs @pN (estilo agent-browser snapshot -i)
#   tapref   @pN [ms]           Tap on the element of that snap ref (re-snap tras cambios)
#   see      [file]             Screenshot PNG -> /sdcard/Download/accessdroid-shot.png
#   tap      X Y [ms]           Tap at (X,Y); optional hold duration
#   longpress X Y [ms]          Long-press at (X,Y); default 500ms
#   swipe    X1 Y1 X2 Y2 [ms]   Swipe/drag
#   scroll   up|down [x y]      Scroll at position
#   back                         Press back
#   home                         Press home
#   recents                      Open recents
#   type     <text>             Type text into the focused field (REPLACES its content)
#   cleartext                   Clear the focused text field
#   paste                       Paste clipboard into the focused field
#   focus     [text|id]         Focus a field by text or resource-id
#   openurl  <url> [pkg]       Open URL in browser (default browser or given package)
#   click    "text"             Click UI element by visible text
#   clickid  resourceId          Click UI element by resource id
#   scrollto "text"             Scroll to an element with text
#   tapshot  X Y [W H]          Tap coords seen in the screenshot PNG (W H = size you saw)
#   float    <texto> [pkg]      Pon la app en ventana flotante (recents->long-press->MIUI)
#   screenshot [file]          Screenshot PNG -> /sdcard/Download/accessdroid-shot.png
#   presskey <key>               Press a key (back/home/recents only)
#==============================================================================

set -u
PROG="amctl"
SECRET="termux-accessdroid-2025"
PKG="com.accessdroid.termux"

# ---- transport auto-detection: AM socket if available, else classic 'am' ----
TRANSPORT="am"
if command -v termux-am >/dev/null 2>&1 && termux-am get-current-user >/dev/null 2>&1; then
    TRANSPORT="socket"
fi

# Run an AM command through the active transport.
tam() {
    if [[ "$TRANSPORT" == "socket" ]]; then
        termux-am "$@"
    else
        am "$@"
    fi
}

# Lifecycle commands (pm/force-stop) need the socket transport.
need_socket() {
    if [[ "$TRANSPORT" != "socket" ]]; then
        echo "amctl $1: requiere el AM socket (app Termux v0.119+)." >&2
        echo "En Termux estable funcionan: tap swipe longpress scroll type cleartext paste focus openurl tapshot" >&2
        echo "clickid click scrollto back home recents presskey screenshot y launch <package.name>" >&2
        return 4
    fi
}

# ---- persistent rish session: 'tail -f <fifo> | rish > out' ----
# Opened ONLY by 'amctl session-start'. tail reads the FIFO and pipes every
# command into rish (which reads stdin); rish's stdout is the out file.
AMCTL_DIR="$HOME/.amctl"
AMCTL_FIFO="$AMCTL_DIR/in"
AMCTL_OUT="$AMCTL_DIR/out"
AMCTL_PID="$AMCTL_DIR/rish.pid"
AMCTL_KEEP_PID="$AMCTL_DIR/tail.pid"
AMCTL_MARKER_WAIT="${AMCTL_MARKER_WAIT:-6}"   # s to wait for the marker
[[ "${AMCTL_MARKER_WAIT%%.*}" =~ ^[0-9]+$ ]] && (( ${AMCTL_MARKER_WAIT%%.*} >= 1 )) || AMCTL_MARKER_WAIT=6
SESSION_START_WAIT="${SESSION_START_WAIT:-10}"   # s for the first marker
[[ "${SESSION_START_WAIT%%.*}" =~ ^[0-9]+$ ]] && (( ${SESSION_START_WAIT%%.*} >= 1 )) || SESSION_START_WAIT=10
SESSION_MS=0

# Ownership (so a recycled pid is never killed):
#   rish : holds the out file as stdout (fd 1)
#   tail : 'tail -f' reopens its file on EOF, so it keeps NO fd on the FIFO ->
#          identified by its command line instead
owns_fd() {
    local l
    l=$(readlink "/proc/$1/fd/$2" 2>/dev/null) || return 1
    [[ "$l" == "$3" ]]
}

session_owner_rish() {
    [[ -n "${1:-}" ]] || return 1
    owns_fd "$1" 1 "$AMCTL_OUT"
}

session_owner_tail() {
    local c
    [[ -n "${1:-}" ]] || return 1
    c=$(tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null) || return 1
    [[ "$c" == *"tail"* && "$c" == *"$AMCTL_FIFO"* ]]
}

live_pid() {
    local f="$1" p
    [[ -f "$f" ]] || return 1
    p=$(cat "$f" 2>/dev/null) || return 1
    [[ "$p" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$p" 2>/dev/null || return 1
    printf '%s' "$p"
}

session_rish_pid() { live_pid "$AMCTL_PID"; }
session_tail_pid() { live_pid "$AMCTL_KEEP_PID"; }

# both halves of the pipeline must be up: without tail no command reaches rish
session_alive() {
    local r t
    r=$(session_rish_pid) || return 1
    t=$(session_tail_pid) || return 1
    [[ -p "$AMCTL_FIFO" ]] || return 1
    session_owner_rish "$r" || return 1
    return 0
}

# leftovers of a session that died: still warns/cleans instead of going silent
session_dirty()   { [[ -e "$AMCTL_FIFO" || -f "$AMCTL_PID" || -f "$AMCTL_KEEP_PID" ]]; }

# ms without forking date (/proc/uptime is not readable on Android)
NOW_MS=0
now_ms() {
    if [[ -n "${EPOCHREALTIME:-}" ]]; then
        NOW_MS=$(( ${EPOCHREALTIME/./} / 1000 ))
    else
        NOW_MS=$(( $(date +%s%N) / 1000000 ))
    fi
}

# one unique random marker per command (never a fixed one)
new_marker() {
    local r
    r=$(od -An -N6 -tx1 /dev/urandom 2>/dev/null | tr -dc 'a-f0-9')
    printf '__amctl_%s_%s__' "$$" "${r:-0}"
}

# POSIX single-quoting for the remote shell (args are never re-parsed)
shquote() {
    local s="${1//\'/\'\\\'\'}"
    printf "'%s'" "$s"
}

# run a command in the session and wait for ITS marker.
# rc 0 ok | 2 rish died / "Server is not running" / "Request timeout" | 3 no answer
session_run() {
    local -a argv=( "$@" )
    local marker line off chunk a pid deadline
    marker=$(new_marker)
    line=''
    for a in "${argv[@]}"; do line+=" $(shquote "$a")"; done
    line+=" ; echo $(shquote "$marker")"
    pid=$(session_rish_pid) || return 2
    [[ -p "$AMCTL_FIFO" && -f "$AMCTL_OUT" ]] || return 2
    off=$(wc -c < "$AMCTL_OUT" 2>/dev/null) || off=0
    off=${off// /}
    timeout 3 bash -c 'printf "%s\n" "$1" > "$2"' _ "$line" "$AMCTL_FIFO" 2>/dev/null || return 3
    now_ms
    deadline=$(( NOW_MS + ${AMCTL_MARKER_WAIT%%.*} * 1000 ))
    while :; do
        chunk=$(tail -c "+$((off + 1))" "$AMCTL_OUT" 2>/dev/null)
        [[ "$chunk" == *"$marker"* ]] && return 0
        case "$chunk" in
            *"Server is not running"*|*"Request timeout"*) return 2 ;;
        esac
        kill -0 "$pid" 2>/dev/null || return 2
        now_ms
        (( NOW_MS >= deadline )) && break
        sleep 0.05
    done
    return 3
}

# warn once and retire a broken session: never retried in a loop
session_drop() {
    session_retire
    echo "amctl: sesión rish no usable ($1) — cae a 'am' clásico; 'amctl session-start' para reabrirla." >&2
}

# kill tail first (rish then sees EOF and exits), then rish; clean FIFO/pidfiles
session_retire() {
    local p
    if p=$(session_tail_pid); then session_owner_tail "$p" && kill "$p" 2>/dev/null; fi
    if p=$(session_rish_pid); then session_owner_rish "$p" && kill "$p" 2>/dev/null; fi
    rm -f "$AMCTL_FIFO" "$AMCTL_PID" "$AMCTL_KEEP_PID" 2>/dev/null
    return 0
}

session_probe() {
    local w="${1:-$AMCTL_MARKER_WAIT}" saved="$AMCTL_MARKER_WAIT" t0 t1 rc=0
    AMCTL_MARKER_WAIT="$w"
    t0=$(date +%s%N)
    session_run true || rc=$?
    t1=$(date +%s%N)
    AMCTL_MARKER_WAIT="$saved"
    SESSION_MS=$(( (t1 - t0) / 1000000 ))
    return "$rc"
}

# ---- send a raw broadcast to AccessDroid (always carries the secret) ----
# session first (if the user started one), classic am otherwise
bc() {
    # $1 = action, rest are --es/--ei/--el extras
    local action="$1"; shift
    if session_alive; then
        local rc=0
        session_run am broadcast -p "$PKG" -a "$action" --es secret "$SECRET" "$@" || rc=$?
        [[ $rc == 0 ]] && return 0
        case "$rc" in
            2) session_drop "rish: Server is not running / Request timeout / rish muerto" ;;
            *) session_drop "sin marcador en ${AMCTL_MARKER_WAIT}s" ;;
        esac
    elif session_dirty; then
        session_drop "rish no está corriendo"
    fi
    tam broadcast -p "$PKG" -a "$action" --es secret "$SECRET" "$@" >/dev/null 2>&1
}

# ---- send a command to the AccessibilityService and report errors ----
ac() {
    local action="$1"; shift
    if ! bc "$action" "$@"; then
        echo "ERROR: failed to send command '$action'." >&2
        echo "Is AccessDroid's accessibility service enabled?" >&2
        echo "Settings -> Accessibility -> AccessDroid -> ON" >&2
        return 3
    fi
}

# ---- wait until a file exists with a stable size ----
# Replaces the fixed sleeps: polls every 0.05s and returns as soon as the file
# has stopped growing (a partially written file is never returned).
# $1 = file, $2 = cap in seconds (same maximum wait the fixed sleeps allowed).
wait_file() {
    local f="${1:-}" cap="${2:-5}"
    cap="${cap%%.*}"
    local max_ms=$(( cap * 1000 )) waited=0 size=-1 stable=0 cur
    while (( waited < max_ms )); do
        if [[ -f "$f" ]]; then
            cur=$(stat -c%s "$f" 2>/dev/null) || cur=-1
            [[ "$cur" =~ ^[0-9]+$ ]] || cur=-1
            if (( cur > 0 )) && [[ "$cur" == "$size" ]]; then
                stable=$(( stable + 1 ))
                (( stable >= 2 )) && return 0
            else
                size="$cur"; stable=0
            fi
        fi
        sleep 0.05
        waited=$(( waited + 50 ))
    done
    return 1
}

# ---- package resolution (substring match -> unique package) ----
resolve_pkg() {
    local input="$1"
    [[ -z "$input" ]] && { echo "missing app/package argument" >&2; return 2; }
    if [[ "$TRANSPORT" != "socket" ]]; then
        if [[ "$input" == *.* ]]; then
            echo "$input"; return 0
        fi
        echo "sin AM socket no hay busqueda por nombre: usa el package name completo (ej: com.android.chrome)" >&2
        return 1
    fi
    if [[ "$input" == *.* ]]; then
        if tam pm list packages 2>/dev/null | sed 's/^package://' | grep -qx "$input"; then
            echo "$input"; return 0
        fi
    fi
    local matches count
    matches=$(tam pm list packages -f 2>/dev/null \
        | sed 's/^package://' | awk -F'=' '{print $1}' | grep -i "$input" || true)
    count=$(echo "$matches" | grep -c .)
    if [[ "$count" -eq 0 ]]; then
        echo "no package matching '$input'" >&2; return 1
    elif [[ "$count" -gt 1 ]]; then
        echo "'$input' matches:"; echo "$matches" >&2; return 1
    fi
    echo "$matches"; return 0
}

# ========================= subcommands =========================

# session lifecycle: only the user opens/closes it, never a command
cmd_start() {
    command -v rish >/dev/null 2>&1 || { echo "amctl session-start: rish no está instalado (necesita Shizuku)" >&2; return 127; }
    if session_alive; then echo "sesión rish ya activa (rish $(session_rish_pid), tail $(session_tail_pid))"; return 0; fi
    session_retire
    mkdir -p "$AMCTL_DIR" || return 1
    chmod 700 "$AMCTL_DIR"
    mkfifo -m 600 "$AMCTL_FIFO" || { echo "amctl session-start: no pude crear $AMCTL_FIFO" >&2; return 1; }
    chmod 600 "$AMCTL_FIFO"
    : > "$AMCTL_OUT" 2>/dev/null; chmod 600 "$AMCTL_OUT" 2>/dev/null
    export RISH_APPLICATION_ID=com.termux
    # verified working form: tail -f <fifo> | rish > out. The wrapper stores both pids.
    nohup bash -c '{ tail -f "$1" & printf "%s\n" "$!" > "$3"; } | rish > "$2" 2>&1 & RP=$!; printf "%s\n" "$RP" > "$4"; wait' \
        _ "$AMCTL_FIFO" "$AMCTL_OUT" "$AMCTL_KEEP_PID" "$AMCTL_PID" >/dev/null 2>&1 &
    disown 2>/dev/null || true
    local i=0
    while (( i < 40 )); do
        [[ -s "$AMCTL_KEEP_PID" && -s "$AMCTL_PID" ]] && break
        sleep 0.05; i=$(( i + 1 ))
    done
    if session_probe "$SESSION_START_WAIT"; then
        echo "sesión rish activa (rish $(session_rish_pid), tail $(session_tail_pid), responde en ${SESSION_MS} ms)"
        echo "backend: broadcasts por la sesión persistente — 'amctl session-stop' la cierra"
        return 0
    fi
    session_retire
    echo "amctl session-start: la sesión rish NO respondió en ${SESSION_START_WAIT}s — sesión cerrada." >&2
    echo "  · ¿Shizuku está abierto y su servidor arrancado?" >&2
    echo "  · ¿rish está instalado? (command -v rish)" >&2
    echo "  · salida de la sesión: $AMCTL_OUT" >&2
    return 1
}

cmd_stop_session() {
    local stopped=0 p
    if p=$(session_tail_pid); then session_owner_tail "$p" && { kill "$p" 2>/dev/null && stopped=1; }; fi
    if p=$(session_rish_pid); then session_owner_rish "$p" && { kill "$p" 2>/dev/null && stopped=1; }; fi
    rm -f "$AMCTL_FIFO" "$AMCTL_PID" "$AMCTL_KEEP_PID" 2>/dev/null
    if [[ $stopped == 1 ]]; then
        echo "sesión rish detenida (rish + tail limpiados)"
    else
        echo "no había ninguna sesión rish activa"
    fi
}

cmd_status() {
    local am="am (clásico)" backend probe
    [[ "$TRANSPORT" == "socket" ]] && am="termux-am (socket)"
    backend="$am"; probe="-"
    local sess="inactiva"
    if session_alive; then
        if session_probe; then
            sess="activa (rish pid $(session_rish_pid))"
            backend="rish (sesión persistente)"
            probe="responde en ${SESSION_MS} ms"
        else
            sess="activa pero sin respuesta"
            probe="SIN RESPUESTA — sesión cerrada"
            session_retire
        fi
    fi
    echo "transporte AM : $am"
    echo "sesión rish   : $sess"
    echo "backend activo: $backend"
    echo "prueba        : $probe"
    echo "salida sesión : $AMCTL_OUT"
}

cmd_list() {
    need_socket list || return $?
    local q="${1:-}"
    tam pm list packages -3 -f 2>/dev/null \
        | sed 's/^package://' \
        | if [[ -n "$q" ]]; then grep -i "$q"; else cat; fi \
        | awk -F'=' '{printf "%-45s %s\n",$1,$2}'
}

cmd_find() {
    need_socket find || return $?
    local q="${1:-}"
    [[ -z "$q" ]] && { echo "usage: amctl find <name>" >&2; return 2; }
    command -v aapt2 >/dev/null && {
        tam pm list packages -3 -f 2>/dev/null | sed 's/^package://' | while IFS='=' read -r pkg apk; do
            local label
            label=$(aapt2 dump badging "$apk" 2>/dev/null | sed -n "s/.*application-label:'(.*)'.app=//p" | head -1)
            [[ -z "$label" ]] && label="(no label)"
            if echo "$label $pkg" | grep -iq "$q"; then
                printf "%-30s %s\n" "$label" "$pkg"
            fi
        done
    } || cmd_list "$q"
    return 0
}

cmd_launch() {
    if [[ "$TRANSPORT" == "socket" ]]; then
        local pkg; pkg=$(resolve_pkg "$1") || return $?
        local comp
        comp=$(tam cmd package resolve-activity --brief \
            -c android.intent.category.LAUNCHER \
            -a android.intent.action.MAIN "$pkg" 2>/dev/null \
            | sed 's/^[^:]*: //' | head -1)
        if [[ -n "$comp" ]]; then
            tam start --user 0 -n "$comp" 2>/dev/null || { echo "launch failed for $pkg"; return 1; }
            echo "Launched $pkg -> $comp"
        else
            tam monkey -p "$pkg" -c android.intent.category.LAUNCHER 1 2>/dev/null \
                && echo "Launched $pkg (monkey)" || { echo "launch failed for $pkg"; return 1; }
        fi
    else
        local pkg="${1:-}"
        if [[ "$pkg" != *.* ]]; then
            echo "uso: amctl launch <package.name>   (sin socket no hay busqueda por nombre)" >&2
            return 2
        fi
        if tam start --user 0 -a android.intent.action.MAIN \
            -c android.intent.category.LAUNCHER -p "$pkg" >/dev/null 2>&1; then
            echo "Launched $pkg"
        elif bc com.accessdroid.termux.ACTION_START_ACTIVITY --es package "$pkg"; then
            echo "Launched $pkg (via AccessDroid)"
        else
            echo "launch failed for $pkg" >&2
            echo "(sin socket hay limite de visibilidad de paquetes: prueba el componente explicito: am start -n $pkg/.ActividadPrincipal)" >&2
            return 1
        fi
    fi
}

cmd_stop()   { need_socket stop || return $?; local pkg; pkg=$(resolve_pkg "$1") || return $?; tam force-stop "$pkg" 2>/dev/null && echo "Stopped $pkg" || { echo "stop failed"; return 1; }; }
cmd_info()   { need_socket info || return $?; local pkg; pkg=$(resolve_pkg "$1") || return $?; tam pm dump "$pkg" 2>/dev/null | grep -E 'versionCode|targetSdk|path|uid|minSdk' | head -8; }
cmd_perms()  { need_socket perms || return $?; local pkg; pkg=$(resolve_pkg "$1") || return $?; tam pm list permissions -g -p "$pkg" 2>/dev/null; }
cmd_grant()  { need_socket grant || return $?; local pkg; pkg=$(resolve_pkg "$1") || return $?; shift; local perm="$1"; tam pm grant "$pkg" "$perm" 2>/dev/null && echo "Granted $perm to $pkg"; }
cmd_revoke() { need_socket revoke || return $?; local p; p=$(resolve_pkg "$1") || return $?; shift; local perm; tam pm revoke "${p}" "${1:-}" 2>/dev/null; }
cmd_clear()  { need_socket clear || return $?; local pkg; pkg=$(resolve_pkg "$1") || return $?; tam clear package "$pkg" 2>/dev/null && echo "Cleared $pkg"; }
cmd_tree()   { local f=/sdcard/Download/accessdroid-tree.txt; rm -f "$f"; bc com.accessdroid.termux.ACTION_GET_UI_TREE; wait_file "$f" 5 && { cat "$f"; return 0; }; echo "(⚠ SERVICIO NO RESPONDE — actívalo en Ajustes → Accesibilidad → CostPhone)"; return 1; }
cmd_snap()   { local f=/sdcard/Download/accessdroid-tree.txt; rm -f "$f"; bc com.accessdroid.termux.ACTION_GET_UI_TREE; wait_file "$f" 5 || { echo "(⚠ SERVICIO NO RESPONDE — actívalo en Ajustes → Accesibilidad → CostPhone)" >&2; return 1; }; python3 "$HOME/bin/amctl-snap.py" "$@"; }

cmd_tapref() {
    local ref="${1:-}"
    [[ -z "$ref" ]] && { echo "uso: amctl tapref @pN  (refs de 'amctl snap')" >&2; return 2; }
    ref="${ref#@}"; [[ "$ref" != p* ]] && ref="p$ref"
    local MAP="$HOME/.cache/amctl/snapshot-map.tsv"
    [[ -f "$MAP" ]] || { echo "no hay snapshot — ejecuta: amctl snap" >&2; return 1; }
    local line; line=$(awk -F'\t' -v r="$ref" '$1==r{print; exit}' "$MAP")
    [[ -z "$line" ]] && { echo "ref @$ref no existe — re-ejecuta: amctl snap" >&2; return 1; }
    local cx cy; cx=$(printf '%s' "$line" | cut -f2); cy=$(printf '%s' "$line" | cut -f3)
    ac com.accessdroid.termux.ACTION_TAP --ei x "$cx" --ei y "$cy" --el duration "${2:-80}"
    echo "tap @$ref -> ($cx,$cy)"
}

# input / UI subcommands (via AccessDroid)

cmd_tap()        { ac com.accessdroid.termux.ACTION_TAP --ei x "${1:-0}" --ei y "${2:-0}" --el duration "${3:-80}"; }
cmd_longpress()  { ac com.accessdroid.termux.ACTION_LONG_PRESS --ei x "${1:-0}" --ei y "${2:-0}" --el duration "${3:-500}"; }
cmd_swipe()      { ac com.accessdroid.termux.ACTION_SWIPE --ei x1 "${1:-0}" --ei y1 "${2:-0}" --ei x2 "${3:-0}" --ei y2 "${4:-0}" --el duration "${5:-300}"; }
cmd_scroll()     { local dir="${1:-down}"; [[ "$dir" == down ]] && ac com.accessdroid.termux.ACTION_SCROLL_DOWN --ei x "${2:-0}" --ei y "${3:-0}" \
                    || ac com.accessdroid.termux.ACTION_SCROLL_UP --ei x "${2:-0}" --ei y "${3:-0}"; }
cmd_back()       { bc com.accessdroid.termux.ACTION_BACK; }
cmd_home()       { bc com.accessdroid.termux.ACTION_HOME; }
cmd_recents()    { bc com.accessdroid.termux.ACTION_RECENTS; }
cmd_type()       { bc com.accessdroid.termux.ACTION_TYPE --es text "$1"; }
cmd_cleartext()  { bc com.accessdroid.termux.ACTION_CLEAR_TEXT; }
cmd_paste()      { bc com.accessdroid.termux.ACTION_PASTE; }
cmd_focus()      { local t="${1:-}"; if [[ -n "$t" ]]; then bc com.accessdroid.termux.ACTION_FOCUS --es text "$t"; else bc com.accessdroid.termux.ACTION_FOCUS; fi; }
cmd_openurl() {
    local url="${1:-}" app="${2:-}"
    [[ -z "$url" ]] && { echo "uso: amctl openurl <url> [pkg-navegador]   (ej: openurl https://x.com com.android.chrome)" >&2; return 2; }
    if tam start --user 0 -a android.intent.action.VIEW -d "$url" ${app:+-p "$app"} >/dev/null 2>&1; then
        echo "openurl: $url${app:+ -> $app}"
    elif [[ -z "$app" ]] && bc com.accessdroid.termux.ACTION_OPEN_URI --es uri "$url"; then
        echo "openurl: $url (via AccessDroid)"
    else
        echo "openurl failed for $url" >&2
        return 1
    fi
}
cmd_tapshot() {
    local png=/sdcard/Download/accessdroid-shot.png
    [[ ! -f "$png" ]] && { echo "no hay screenshot: ejecuta primero amctl see" >&2; return 1; }
    local dim
    dim=$(python3 - "$png" <<'PY'
import struct, sys
with open(sys.argv[1], "rb") as f:
    f.seek(16)
    w, h = struct.unpack(">II", f.read(8))
print(w, h)
PY
) || { echo "no pude leer el PNG" >&2; return 1; }
    local pw ph; read -r pw ph <<<"$dim"
    local x="${1:-}" y="${2:-}" wsi="${3:-}" hsi="${4:-}"
    [[ -z "$x" || -z "$y" ]] && { echo "uso: amctl tapshot X Y [W H]  (X,Y vistos en la imagen, opcional su tamaño WxH)" >&2; return 2; }
    local sx=1.0 sy=1.0
    if [[ -n "$wsi" && "$wsi" != 0 ]]; then
        if [[ -z "$hsi" || "$hsi" == 0 ]]; then
            sx=$(python3 -c "print($pw/$wsi)"); sy=$sx
        else
            sx=$(python3 -c "print($pw/$wsi)"); sy=$(python3 -c "print($ph/$hsi)")
        fi
    fi
    local tx ty
    read -r tx ty < <(python3 -c "print(int($x*$sx+.5), int($y*$sy+.5))")
    ac com.accessdroid.termux.ACTION_TAP --ei x "$tx" --ei y "$ty" --el duration 80
    echo "tapshot ($x,$y)x(${sx}:${sy}) -> png ${pw}x${ph} -> tap ($tx,$ty)"
}
cmd_click()      { bc com.accessdroid.termux.ACTION_CLICK_TEXT --es text "$1"; }
cmd_clickid()    { bc com.accessdroid.termux.ACTION_CLICK_ID --es id "$1"; }
cmd_scrollto()   { bc com.accessdroid.termux.ACTION_SCROLL_TO --es text "$1"; }
cmd_shot()       { local f="${1:-/sdcard/Download/accessdroid-shot.png}"; local i; rm -f "$f" 2>/dev/null; for i in 1 2 3; do bc com.accessdroid.termux.ACTION_SCREENDUMP; wait_file "$f" 2 && break; done; if [[ -f "$f" ]]; then echo "PNG: $f ($(stat -c%s "$f") bytes)"; else echo "(no se guardo el PNG)"; if [[ -f /sdcard/Download/accessdroid-shot-error.txt ]]; then echo "error del servicio:"; cat /sdcard/Download/accessdroid-shot-error.txt; fi; fi; }
cmd_presskey()   { local k="$1"; local code=0; case "$k" in back) code=4;; home) code=3;; recents) code=187;; *) echo "only back|home|recents supported" >&2; return 1;; esac; bc com.accessdroid.termux.ACTION_PRESS_KEY --ei keyCode "$code"; }

# float <texto>: recents -> tarjeta de la app (por texto) -> long-press -> 'ventanas flotantes'
# (flujo MIUI/HyperOS verificado: recents, longpress en tarjeta, menu_item_small_window)
cmd_float() {
    local target="${1:-}"
    local pkg="${2:-}"
    [[ -z "$target" ]] && { echo "uso: amctl float <texto-tarjeta-en-recents> [pkg]   (ej: amctl float Termux — si no está en recents, láncala con: amctl float Galeria com.miui.gallery)" >&2; return 2; }
    shift 2; local extra="${1:-}"   # 3er arg: 'split' -> pantalla dividida
    local t="${target,,}"
    bc com.accessdroid.termux.ACTION_RECENTS; sleep 2
    local out row
    out=$(cmd_snap 2>/dev/null)
    row=$(printf '%s\n' "$out" | awk -v t="$t" 'tolower($0) ~ t && /^@p[0-9]+ \[Frame/ {print; exit}')
    if [[ -z "$row" && -n "$pkg" ]]; then
        cmd_launch "$pkg" >/dev/null 2>&1; sleep 4
        bc com.accessdroid.termux.ACTION_RECENTS; sleep 2
        out=$(cmd_snap 2>/dev/null)
        row=$(printf '%s\n' "$out" | awk -v t="$t" 'tolower($0) ~ t && /^@p[0-9]+ \[Frame/ {print; exit}')
    fi
    [[ -z "$row" ]] && { echo "amctl float: no encontré la tarjeta '$target' en recents (¿está abierta la app? usa el pkg como 2do arg)" >&2; return 1; }
    read -r cx cy <<<"$(printf '%s' "$row" | sed -E 's/.*\(([0-9]+),([0-9]+)\).*/\1 \2/')"
    cmd_longpress "$cx" "$cy" 700 >/dev/null; sleep 2
    out=$(cmd_snap 2>/dev/null)
    local want="menu_item_small_window"
    [[ "$extra" == 'split' ]] && want="menu_item_multi_window"
    row=$(printf '%s\n' "$out" | awk -v w="$want" '$0 ~ w {print; exit}')
    [[ -z "$row" ]] && { row=$(printf '%s\n' "$out" | awk 'tolower($0) ~ /ventanas flotantes/ {print; exit}'); }
    [[ -z "$row" ]] && { echo "amctl float: la app no ofrece ventana flotante en MIUI, pruebalo manual o usa 'float <texto> split'" >&2; return 1; }
    read -r cx cy <<<"$(printf '%s' "$row" | sed -E 's/.*\(([0-9]+),([0-9]+)\).*/\1 \2/')"
    ac com.accessdroid.termux.ACTION_TAP --ei x "$cx" --ei y "$cy" --el duration 80
    echo "float: $target -> ventana flotante"
}

# ========================= dispatcher =========================
case "${1:-help}" in
    session-start) cmd_start ;;
    session-stop)  cmd_stop_session ;;
    status)        cmd_status ;;
    list)      cmd_list "${2:-}" ;;
    find)      cmd_find "${2:-}" ;;
    launch)    cmd_launch "${2:-}" ;;
    stop)      cmd_stop "${2:-}" ;;
    info)      cmd_info "${2:-}" ;;
    perms)     cmd_perms "${2:-}" ;;
    grant)     cmd_grant "${2:-}" "${3:-}" ;;
    revoke)    cmd_revoke "${2:-}" "${3:-}" ;;
    clear)     cmd_clear "${2:-}" ;;
    tree)      cmd_tree ;;
    snap)      shift; cmd_snap "$@" ;;
    tapref)    cmd_tapref "${2:-}" "${3:-}" ;;
    tap)       cmd_tap "${2:-}" "${3:-}" "${4:-80}" ;;
    longpress) cmd_longpress "${2:-0}" "${3:-0}" "${4:-500}" ;;
    swipe)     cmd_swipe "${2:-0}" "${3:-0}" "${4:-0}" "${5:-0}" "${6:-300}" ;;
    scroll)    cmd_scroll "${2:-down}" "${3:-0}" "${4:-0}" ;;
    back)      cmd_back ;;
    home)      cmd_home ;;
    recents)   cmd_recents ;;
    float)     cmd_float "${2:-}" "${3:-}" "${4:-}" ;;
    type)      cmd_type "${2:-}" ;;
    cleartext) cmd_cleartext ;;
    paste)     cmd_paste ;;
    focus)     cmd_focus "${2:-}" ;;
    openurl)   cmd_openurl "${2:-}" ;;
    tapshot)   cmd_tapshot "${2:-}" "${3:-}" "${4:-}" "${5:-}" ;;
    click)     cmd_click "${2:-}" ;;
    clickid)   cmd_clickid "${2:-}" ;;
    scrollto)  cmd_scrollto "${2:-}" ;;
    screenshot) cmd_shot "${2:-}" ;;
    shot)      cmd_shot "${2:-}" ;;
    see)       cmd_shot "${2:-}" ;;
    presskey)  cmd_presskey "${2:-}" ;;
    help|-h|--help)
        awk '/^#====/{c++; if(c==2) exit} c>=1{print}' "$0" | sed 's/^# \{0,1\}//' ;;
    *) echo "unknown command: $1 (use 'amctl help')" >&2; exit 1 ;;
esac
