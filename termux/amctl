#!/data/data/com.termux/files/usr/bin/bash
#==============================================================================
# amctl - App control toolkit for Termux
# Drives the CostPhone AccessibilityService (simulates clicks, scrolls,
# type-into-field, UI-tree inspection) + app lifecycle.
#
# Prerequisites:
#   1. CostPhone APK built & installed (see app/build.sh)
#   2. Settings -> Accessibility -> CostPhone  =>  ON
#
# Transport (auto):
#   "socket": TCP local 127.0.0.1:39871-39875. Es el canal normal: la orden y
#             su respuesta viajan en un solo ida y vuelta, sin ficheros ni
#             esperas. Requiere app v1.3+.
#   "am":     broadcast clásico de Termux + fichero en /sdcard/Download.
#             Solo si el canal rápido no está (app vieja o servicio parado).
#             Cada orden cuesta de 1 a 5 segundos (broadcast + escritura +
#             sondeo), así que se avisa.
#
# Usage: amctl <command> [args...]
#   batch    "cmd1; cmd2"       Varias órdenes en UN proceso (1 solo exec)
#   warmup                     Abre el canal y cachea el puerto (pre-calentar)
#   list     [query]            List 3rd-party apps
#   find     <name>             Search apps by package name (shows the real label)
#   launch   <app|pkg>          Launch an app
#   stop     <app|pkg>          Force-stop an app
#   info     <app|pkg>          Package info
#   perms    <app|pkg>          List app permissions
#   grant    <app|pkg> <perm>   Grant a permission
#   revoke   <app|pkg> <perm>   Revoke a permission
#   clear    <app|pkg>          Clear app data/cache
#   tree                         Dump current UI tree (raw)
#   snap     [-a] [--filter T]  Snapshot con refs @pN (estilo agent-browser)
#   tapref   @pN [--settle ms]  Tap on the element of that snap ref
#   waitfor  "text" [ms]        Espera a que aparezca un texto (1 solo viaje)
#   see      [file] [--scale S] Captura JPEG de la pantalla
#   ocr      "texto" [conf] [--region x,y,w,h]  OCR de la captura: coordenadas de un texto
#   tap      X Y [ms]           Tap at (X,Y); optional hold duration
#   longpress X Y [ms]          Long-press at (X,Y); default 500ms
#   swipe    X1 Y1 X2 Y2 [ms]   Swipe/drag
#   scroll   up|down [x y]      Scroll at position
#   back / home / recents       Botones del sistema
#   type     <text>             Type text into the focused field (REPLACES it)
#   cleartext                   Clear the focused text field
#   paste                       Paste clipboard into the focused field
#   focus     [text|id]         Focus a field by text or resource-id
#   openurl  <url> [pkg]       Open URL in browser (default browser or given pkg)
#   click    "text"             Click UI element by visible text
#   clickid  resourceId         Click UI element by resource id
#   scrollto "text"             Scroll to an element with text
#   tapshot  X Y [W H]          Tap coords seen in the screenshot PNG (W H = size you saw)
#   float    <texto> [pkg]      Pon la app en ventana flotante (recents->long-press->MIUI)
#   presskey <key>               Press a key (back/home/recents only)
#
# Pantalla virtual (display secundario para el agente):
#   display                    Lista los displays (id, tamaño, dpi)
#   display on [w h dpi flags] Crea la pantalla virtual (def: 1080 1920 320).
#                              flags: gravity_top_left|top_right|bottom_left|bottom_right
#   display off                La apaga
#   -d N / --display N         Dirige ESTA orden al display N (ej: amctl -d 2 snap).
#                              Sin -d, todo va a la pantalla 0 (la del usuario).
#==============================================================================

set -u
PROG="amctl"
