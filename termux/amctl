# ---- flags globales: -d N / --display N  (resto en POSITIONAL) ----
parse_display() {
    POSITIONAL=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d|--display)
                if [[ -n "${2:-}" ]]; then DISPLAY_ID="$2"; shift 2; continue; fi ;;
            # "-d2" pegado, pero solo si NO lleva espacios dentro: si los
            # lleva es un argumento normal (p.ej. el spec de `batch`).
            -d?*) [[ "${1#-d}" != *[[:space:]]* ]] && { DISPLAY_ID="${1#-d}"; shift; continue; } ;;
        esac
        POSITIONAL+=("$1"); shift
    done
}

# ==========================================================================
#  Canal rápido: TCP de loopback contra el servicio de accesibilidad
# ==========================================================================
CP_PORTS=(39871 39872 39873 39874 39875)
# La app se ata al IPv4 de loopback, pero en Android 16 getLoopbackAddress()
# devuelve ::1 — probamos los dos por si acaso.
CP_HOSTS=(127.0.0.1 ::1)
CP_CODE=""      # ok | fail | empty
CP_TEXT=""      # cuerpo de texto
CP_B64=""       # cuerpo binario en base64
CP_ARGS=""      # payload de argumentos (se codifica en un bloque)

# Añade un argumento al payload: tipo (i/l/f/s) + clave + valor.
cp_arg() {
    local v="$3"
    v=${v//\\/\\\\}
    v=${v//$'\n'/\\n}
    CP_ARGS="${CP_ARGS}$1:$2=$v"$'\n'
}

# Codifica el payload de argumentos (base64 en bash puro: 0 execs).
cp_encode_args() {
    if [[ -z "$CP_ARGS" ]]; then printf ''; return; fi
    cp_b64 "$CP_ARGS"
}

# Devuelve "host puerto" donde el servicio esté escuchando (o falla).
# CP_HOST y CP_PORT quedan fijados para no tener que abrir un subshell.
CP_HOST=""
CP_PORT=""
cp_port() {
    local f="$CACHE/port" p host
    # 1) caché: NO se re-valida con un connect extra (eso costaba un syscall
    #    por orden). Si el puerto está muerto, lo detecta el propio cp_call.
    if [[ -f "$f" ]]; then
        read -r host p < "$f" 2>/dev/null || true
        if [[ -n "${host:-}" && -n "${p:-}" ]]; then
            CP_HOST="$host"; CP_PORT="$p"; return 0
        fi
    fi
    # 2) escaneo de puertos
    for p in "${CP_PORTS[@]}"; do
        for host in "${CP_HOSTS[@]}"; do
            if { exec 7<>"/dev/tcp/$host/$p"; } 2>/dev/null; then
                exec 7<&- 7>&-
                CP_HOST="$host"; CP_PORT="$p"
                cp_cache_ensure
                printf '%s %s\n' "$host" "$p" > "$f" 2>/dev/null || true
                return 0
            fi
        done
    done
    return 1
}

# Manda una orden por el canal rápido. Devuelve 0 si hubo respuesta.
cp_call() {
    local action="$1" args="${2:-}"
    local head code len enc body
    CP_CODE=""; CP_TEXT=""; CP_B64=""
    cp_port || return 1
    if ! { exec 7<>"/dev/tcp/$CP_HOST/$CP_PORT"; } 2>/dev/null; then
        # el puerto cacheado estaba muerto: se reescanea una vez
        rm -f "$CACHE/port" 2>/dev/null || true
        cp_port || return 1
        { exec 7<>"/dev/tcp/$CP_HOST/$CP_PORT"; } 2>/dev/null || return 1
    fi
    if ! printf 'CP/1 %s b:secret=%s b:args=%s\n' "$action" "$SECRET_B64" "$args" >&7 2>/dev/null; then
        exec 7<&- 7>&-; return 1
    fi
    if IFS= read -r -t 25 head <&7; then
        read -r _ code len enc <<<"$head"
        body=""
        if [[ "${len:-0}" =~ ^[0-9]+$ && "${len:-0}" -gt 0 ]]; then
            IFS= read -r -N "$len" body <&7 2>/dev/null || true
        fi
        exec 7<&- 7>&-
        CP_CODE="${code:-fail}"
        if [[ "${enc:-raw}" == "b64" ]]; then CP_B64="$body"; else CP_TEXT="$body"; fi
        return 0
    fi
    exec 7<&- 7>&-
    return 1
}

# ¿Respondió el canal rápido? (1 intento, para no gastar 5 conexiones)
cp_alive() {
    CP_ARGS=""
    cp_call $ACTION_PING "" || return 1
    [[ "$CP_CODE" == "ok" ]]
}

# Imprime el cuerpo de la última respuesta y devuelve su código.
cp_report() {
    local body="${CP_TEXT:-$CP_B64}"
    case "$CP_CODE" in
        ok)     [[ -n "$body" ]] && printf '%s\n' "$body"; return 0 ;;
        empty)  [[ -n "$body" ]] && printf '%s\n' "$body" >&2; return 1 ;;
        *)      [[ -n "$body" ]] && printf '%s\n' "$body" >&2; return 1 ;;
    esac
}

# ==========================================================================
#  Canal rápido: ÚNICO transporte (app v1.3+)
# ==========================================================================
#  Antes había un canal legacy (broadcast -> fichero en /sdcard -> sondeo)
#  que costaba 1-5 s por orden. Desde la v1.3 el servicio de accesibilidad
#  habla por TCP de loopback, así que el legacy se ha eliminado: mantenerlo
#  solo dejaba trampas (una orden que caía en modo lento sin avisar).
#
#  Lo que sí se mantiene es `pm` (list/find/resolve_pkg), que necesita el
#  socket de Termux:API.
TRANSPORT="am"
detect_transport() {
    local f="$CACHE/transport" now ts val
    cp_now; now="$CP_NOW"          # printf '%(%s)T' (sin fork; date +%s cuesta 150 ms)
    if [[ -f "$f" ]]; then
        read -r ts val < "$f" 2>/dev/null || true
        if [[ -n "${ts:-}" && -n "${val:-}" && $((now - ts)) -lt 300 ]]; then
            TRANSPORT="$val"; return
        fi
    fi
    TRANSPORT="am"
    if command -v termux-am >/dev/null 2>&1 && termux-am get-current-user >/dev/null 2>&1; then
        TRANSPORT="socket"
    fi
    cp_cache_ensure
    printf '%s %s\n' "$now" "$TRANSPORT" > "$f" 2>/dev/null || true
}

tam() {
    if [[ "$TRANSPORT" == "socket" ]]; then
        termux-am "$@"
    else
        am "$@"
    fi
}

shot_file() {
    if [[ "$DISPLAY_ID" == "0" ]]; then echo "/sdcard/Download/accessdroid-shot.jpg"
    else echo "/sdcard/Download/accessdroid-shot-d$DISPLAY_ID.jpg"; fi
}

# Ejecuta una orden simple: canal rápido si está; si no, broadcast.
#   $1 = acción del canal rápido, $2 = acción broadcast,
#   $3.. = argumentos "tipo:clave=valor" (i/l/f/s).
# El valor puede contener espacios y signos "=" (URLs, textos).
P_TYPES=(); P_KEYS=(); P_VALS=()
parse_kv() {
    P_TYPES=(); P_KEYS=(); P_VALS=()
    local kv rest
    for kv in "$@"; do
        rest="${kv#*:}"
        P_TYPES+=("${kv%%:*}")
        P_KEYS+=("${rest%%=*}")
        P_VALS+=("${rest#*=}")
    done
}

cp_or_bc() {
    local cpaction="$1" bcaction="$2"; shift 2
    CP_ARGS=""
    parse_kv "$@"
    local i
    for (( i=0; i<${#P_TYPES[@]}; i++ )); do
        cp_arg "${P_TYPES[$i]}" "${P_KEYS[$i]}" "${P_VALS[$i]}"
    done
    if cp_call "$cpaction" "$(cp_encode_args)"; then
        cp_report
        return $?
    fi
    # sin canal rápido no hay alternativa: el broadcast legacy se eliminó
    # (era 100x más lento y hacía fallar la orden en silencio).
    cp_no_channel
    return 1
}

# ---- avisa de que el canal rápido no está ----
cp_no_channel() {
    echo "canal rápido no disponible: la app v1.3+ debe estar instalada y el" >&2
    echo "servicio de accesibilidad activado (Ajustes → Accesibilidad →" >&2
    echo "CostPhone), o ejecuta 'amctl enable' para reactivarlo solo." >&2
}

# ========================= subcommands =========================

# Lista paquetes: "path\tpaquete". El binario pm de Android (no el shim tam,
# que necesita la app Termux:API corriendo).
pm_pkgs() {
    local extra="-3"; [[ "${1:-}" == "all" ]] && extra=""
    ( command pm list packages $extra -f 2>/dev/null || tam pm list packages $extra -f 2>/dev/null ) \
    | sed 's/^package://' \
    | awk -F= '{pkg=$NF; path=substr($0,1,length($0)-length(pkg)-1); print path"\t"pkg}'
}

cmd_list() {
    detect_transport
    local q="${1:-}" scope="${2:-}"
    pm_pkgs "$scope" \
    | if [[ -n "$q" ]]; then grep -i -- "$q"; else cat; fi \
    | awk -F'\t' '{printf "%-62s %s\n",$1,$2}'
}

cmd_find() {
    # Busca una app por nombre de PAQUETE (rápido) y muestra su etiqueta real.
    # La etiqueta se saca con aapt2 solo de los que coinciden: volcar 300 APKs
    # del sistema sería lentísimo.
    detect_transport
    local q="${1:-}"
    [[ -z "$q" ]] && { echo "usage: amctl find <paquete>" >&2; return 2; }
    local n=0
    while IFS=$'\t' read -r apk pkg; do
        echo "$pkg" | grep -iq -- "$q" || continue
        local label=""
        command -v aapt2 >/dev/null 2>&1 && \
            label=$(aapt2 dump badging "$apk" 2>/dev/null | sed -n "s/^application-label:'\(.*\)'.*/\1/p" | head -1)
        [[ -z "$label" ]] && label="(sin etiqueta)"
        printf "%-32s %s\n" "$label" "$pkg"
        n=$((n+1))
    done < <(pm_pkgs all)
    [[ $n -eq 0 ]] && echo "sin coincidencias para '$q'" >&2
    return 0
}

# ---- package resolution (substring match -> unique package) ----
# Caché de la lista de paquetes: `pm list packages` + sed + awk + grep eran
# 5 execs (~800 ms). Ahora se cachea y el filtrado es puro bash.
resolve_pkg() {
    local input="$1"
    [[ -z "$input" ]] && { echo "missing app/package argument" >&2; return 2; }
    detect_transport
    if [[ "$TRANSPORT" != "socket" ]]; then
        if [[ "$input" == *.* ]]; then
            echo "$input"; return 0
        fi
        echo "sin AM socket no hay busqueda por nombre: usa el package name completo (ej: com.android.chrome)" >&2
        return 1
    fi
    local cachef="$CACHE/pkgs.tsv" now ts
    cp_now; now="$CP_NOW"
    if [[ -f "$cachef" ]]; then
        read -r ts < "$cachef" 2>/dev/null || true
    else
        ts=0
    fi
    if [[ ! -f "$cachef" || $((now - ts)) -gt 300 ]]; then
        local raw
        raw=$(tam pm list packages 2>/dev/null) || raw=""
        if [[ -z "$raw" ]]; then
            echo "no se pudo listar los paquetes (¿Termux:API?)" >&2; return 1
        fi
        cp_cache_ensure
        { printf '%s\n' "$now"; printf '%s\n' "$raw"; } > "$cachef" 2>/dev/null || true
    fi
    # coincidencia exacta primero
    local line pkg
    while IFS= read -r line; do
        [[ "$line" == "package:"* ]] || continue
        pkg="${line#package:}"
        [[ "$pkg" == "$input" ]] && { echo "$pkg"; return 0; }
    done < "$cachef"
    # si no, subcadena (case-insensitive) y tiene que ser única
    local needle="${input,,}" matches=() m
    while IFS= read -r line; do
        [[ "$line" == "package:"* ]] || continue
        pkg="${line#package:}"
        [[ "${pkg,,}" == *"${needle}"* ]] && matches+=("$pkg")
    done < "$cachef"
    case ${#matches[@]} in
        0) echo "no package matching '$input'" >&2; return 1 ;;
        1) echo "${matches[0]}"; return 0 ;;
        *) echo "'$input' matches:"; printf '%s\n' "${matches[@]}" >&2; return 1 ;;
    esac
}

cmd_launch() {
    local arg="${1:-}"
    [[ -z "$arg" ]] && { echo "uso: amctl launch <package.name>" >&2; return 2; }
    local pkg
    if [[ "$arg" == *.* ]]; then pkg="$arg"; else pkg=$(resolve_pkg "$arg") || return $?; fi

    # canal rápido: la app sabe lanzar en un display concreto
    CP_ARGS=""
    cp_arg s package "$pkg"
    cp_arg i display "$DISPLAY_ID"
    if cp_call $ACTION_START_ACTIVITY "$(cp_encode_args)"; then
        cp_report
        return $?
    fi
    cp_no_channel
    return 1
}

cmd_stop()   { detect_transport; local pkg; pkg=$(resolve_pkg "$1") || return $?; tam force-stop "$pkg" 2>/dev/null && echo "Stopped $pkg" || { echo "stop failed"; return 1; }; }
cmd_info()   { detect_transport; local pkg; pkg=$(resolve_pkg "$1") || return $?; tam pm dump "$pkg" 2>/dev/null | grep -E 'versionCode|targetSdk|path|uid|minSdk' | head -8; }
cmd_perms()  { detect_transport; local pkg; pkg=$(resolve_pkg "$1") || return $?; tam pm list permissions -g -p "$pkg" 2>/dev/null; }
cmd_grant()  { detect_transport; local pkg; pkg=$(resolve_pkg "$1") || return $?; shift; local perm="$1"; tam pm grant "$pkg" "$perm" 2>/dev/null && echo "Granted $perm to $pkg"; }
cmd_revoke() { detect_transport; local p; p=$(resolve_pkg "$1") || return $?; shift; local perm; perm="${1:-}"; tam pm revoke "${p}" "$perm" 2>/dev/null; }
cmd_clear()  { detect_transport; local pkg; pkg=$(resolve_pkg "$1") || return $?; tam clear package "$pkg" 2>/dev/null && echo "Cleared $pkg"; }

# ---- árbol crudo ----
cmd_tree() {
    CP_ARGS=""
    cp_arg i display "$DISPLAY_ID"
    if cp_call $ACTION_GET_UI_TREE "$(cp_encode_args)"; then
        [[ -n "$CP_TEXT" ]] && printf '%s' "$CP_TEXT"
        [[ "$CP_CODE" == "ok" ]] && return 0
        return 1
    fi
    cp_no_channel
    return 1
}

# ---- snapshot con refs @pN ----
cmd_snap() {
    local mode=0 filter=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -a|--all) mode=1; shift ;;
            --filter) filter="${2:-}"; shift 2 ;;
            --filter=*) filter="${1#*=}"; shift ;;
            *) shift ;;
        esac
    done

    # el snapshot lo calcula el servicio (sin Python, sin ficheros)
    CP_ARGS=""
    cp_arg i display "$DISPLAY_ID"
    cp_arg i mode "$mode"
    [[ -n "$filter" ]] && cp_arg s filter "$filter"
    if cp_call $ACTION_GET_SNAPSHOT "$(cp_encode_args)"; then
        cp_report
        return $?
    fi
    cp_no_channel
    return 1
}

# ---- dormir sin exec (un exec de `sleep` cuesta ~150 ms) ----
# Truco: se abre una conexión al servicio (que no manda nada) y se lee de
# ella con timeout. read -t devuelve al expirar el plazo.
# Entrada: MILISEGUNDOS.
cp_sleep_ms() {
    local ms="${1:-0}"
    [[ "$ms" =~ ^[0-9]+$ ]] || return 0
    (( ms <= 0 )) && return 0
    local sec="$(( ms / 1000 )).$(printf '%03d' $(( ms % 1000 )))"
    local fd=9
    { exec {fd}<>"/dev/tcp/$CP_HOST/$CP_PORT"; } 2>/dev/null || {
        # sin canal rápido: se duerme con el binario del sistema
        command sleep "$sec"
        return 0
    }
    IFS= read -r -t "$sec" -u "$fd" 2>/dev/null || true
    exec {fd}<&- {fd}>&-
    return 0
}

# ---- tocar una ref ----
cmd_tapref() {
    local ref="${1:-}" settle=""
    [[ -z "$ref" ]] && { echo "uso: amctl tapref @pN [--settle ms]" >&2; return 2; }
    shift || true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --settle) settle="${2:-300}"; shift 2 ;;
            --settle=*) settle="${1#*=}"; shift ;;
            *) shift ;;
        esac
    done

    # canal rápido: el servicio resuelve la ref (y avisa si quedó obsoleta)
    CP_ARGS=""
    cp_arg s ref "$ref"
    cp_arg i display "$DISPLAY_ID"
    # el "settle" se lo pide al SERVICIO: si duerme el servidor, el CLI no
    # paga un exec de sleep (150 ms) ni uno de awk para las fracciones.
    [[ -n "$settle" ]] && cp_arg l settle "$settle"
    if cp_call $ACTION_TAPREF "$(cp_encode_args)"; then
        local rc=0
        cp_report || rc=1
        # si el servidor no devolvió la marca "[settled", es una app vieja:
        # se duerme aquí (sin exec).
        if [[ -n "$settle" && "$CP_TEXT" != *"[settled"* ]]; then
            cp_sleep_ms "$settle"
        fi
        return $rc
    fi
    cp_no_channel
    return 1
}

# ---- esperar a que aparezca un texto ----
cmd_waitfor() {
    local text="${1:-}" timeout="${2:-8000}"
    [[ -z "$text" ]] && { echo "uso: amctl waitfor \"texto\" [ms]" >&2; return 2; }
    CP_ARGS=""
    cp_arg s text "$text"
    cp_arg l timeout "$timeout"
    cp_arg i display "$DISPLAY_ID"
    cp_arg i mode 0
    if cp_call $ACTION_WAITFOR "$(cp_encode_args)"; then
        cp_report
        return $?
    fi
    cp_no_channel
    return 1
}

