cmd_shot()       { local f="${1:-/sdcard/Download/accessdroid-shot.png}"; local i; rm -f "$f" 2>/dev/null; for i in 1 2 3; do bc com.accessdroid.termux.ACTION_SCREENDUMP; wait_file "$f" 2 && break; done; if [[ -f "$f" ]]; then echo "PNG: $f ($(stat -c%s "$f") bytes)"; else echo "(no se guardo el PNG)"; if [[ -f /sdcard/Download/accessdroid-shot-error.txt ]]; then echo "error del servicio:"; cat /sdcard/Download/accessdroid-shot-error.txt; fi; fi; }
cmd_presskey()   { local k="$1"; local code=0; case "$k" in back) code=4;; home) code=3;; recents) code=187;; *) echo "only back|home|recents supported" >&2; return 1;; esac; bc com.accessdroid.termux.ACTION_PRESS_KEY --ei keyCode "$code"; }

# float <texto>: recents -> tarjeta de la app (por texto) -> long-press -> 'ventanas flotantes'
# (flujo MIUI/HyperOS verificado: recents, longpress en tarjeta, menu_item_small_window)
cmd_float() {
    local target="${1:-}"
    local pkg="${2:-}"
    [[ -z "$target" ]] && { echo "uso: amctl float <texto-tarjeta-en-recents> [pkg]   (ej: amctl float Termux — si no está en recents, láncala con: amctl float Galeria com.miui.gallery)" >&2; return 2; }
    shift 2; local extra="${1:-}"   # 3er arg: 'split' -> pantalla dividida
    local t="${target,,}"
    bc com.accessdroid.termux.ACTION_RECENTS; sleep 2
    local out row
    out=$(cmd_snap 2>/dev/null)
    row=$(printf '%s\n' "$out" | awk -v t="$t" 'tolower($0) ~ t && /^@p[0-9]+ \[Frame/ {print; exit}')
    if [[ -z "$row" && -n "$pkg" ]]; then
        cmd_launch "$pkg" >/dev/null 2>&1; sleep 4
        bc com.accessdroid.termux.ACTION_RECENTS; sleep 2
        out=$(cmd_snap 2>/dev/null)
        row=$(printf '%s\n' "$out" | awk -v t="$t" 'tolower($0) ~ t && /^@p[0-9]+ \[Frame/ {print; exit}')
    fi
    [[ -z "$row" ]] && { echo "amctl float: no encontré la tarjeta '$target' en recents (¿está abierta la app? usa el pkg como 2do arg)" >&2; return 1; }
    read -r cx cy <<<"$(printf '%s' "$row" | sed -E 's/.*\(([0-9]+),([0-9]+)\).*/\1 \2/')"
    cmd_longpress "$cx" "$cy" 700 >/dev/null; sleep 2
    out=$(cmd_snap 2>/dev/null)
    local want="menu_item_small_window"
    [[ "$extra" == 'split' ]] && want="menu_item_multi_window"
    row=$(printf '%s\n' "$out" | awk -v w="$want" '$0 ~ w {print; exit}')
    [[ -z "$row" ]] && { row=$(printf '%s\n' "$out" | awk 'tolower($0) ~ /ventanas flotantes/ {print; exit}'); }
    [[ -z "$row" ]] && { echo "amctl float: la app no ofrece ventana flotante en MIUI, pruebalo manual o usa 'float <texto> split'" >&2; return 1; }
    read -r cx cy <<<"$(printf '%s' "$row" | sed -E 's/.*\(([0-9]+),([0-9]+)\).*/\1 \2/')"
    ac com.accessdroid.termux.ACTION_TAP --ei x "$cx" --ei y "$cy" --el duration 80
    echo "float: $target -> ventana flotante"
}

# ========================= B2 subcommands =========================

cmd_input() {
    local sub="${1:-}"
    case "$sub" in
        tap|swipe|text|keyevent) ;;
        "") echo "uso: amctl input tap X Y | swipe X1 Y1 X2 Y2 [ms] | text TEXTO | keyevent CODIGO" >&2; return 2 ;;
        *) echo "amctl input: subcomando '$sub' no permitido (modo $AMCTL_MODE)" >&2; return 2 ;;
    esac
    shift || true
    need_session "input $sub" || return $?
    # only HOME escapes the guard: it is the key that leaves Termux
    if [[ "$sub" == keyevent && "${1:-}" == home ]]; then
        amctl_log input "input keyevent 3 (HOME, sin guardia)"
        sh_exec "$AMCTL_MARKER_WAIT" input keyevent 3 && echo "keyevent 3 (HOME) [sesión rish]"
        return 0
    fi
    guard_action "input $sub" || return $?
    scale_guard
    case "$sub" in
        tap)
            local x y
            num_arg "${1:-}" x || return 2
            num_arg "${2:-}" y || return 2
            bounds_check "$x" "$y"
            amctl_log input "input tap $x $y"
            sh_exec "$AMCTL_MARKER_WAIT" input tap "$x" "$y" && echo "tap ($x,$y) [sesión rish]"
            ;;
        swipe)
            local x1 y1 x2 y2 ms
            num_arg "${1:-}" x1 || return 2
            num_arg "${2:-}" y1 || return 2
            num_arg "${3:-}" x2 || return 2
            num_arg "${4:-}" y2 || return 2
            ms="${5:-300}"
            num_arg "$ms" ms || return 2
            (( ms > 8000 )) && { echo "amctl: duración de swipe > 8000ms no permitida" >&2; return 2; }
            amctl_log input "input swipe $x1 $y1 $x2 $y2 $ms"
            sh_exec "$AMCTL_MARKER_WAIT" input swipe "$x1" "$y1" "$x2" "$y2" "$ms" && echo "swipe ($x1,$y1)->($x2,$y2) ${ms}ms [sesión rish]"
            ;;
        text)
            local t="$*" esc
            [[ -z "$t" ]] && { echo "uso: amctl input text TEXTO" >&2; return 2; }
            (( ${#t} > 500 )) && { echo "amctl: texto demasiado largo (máx 500)" >&2; return 2; }
            if [[ "$t" == *[$'\x01'-$'\x1f'$'\x7f']* ]]; then
                echo "amctl: el texto contiene caracteres de control (incluye saltos de línea): no se envía" >&2
                return 2
            fi
            [[ "$t" =~ [^[:print:][:space:]] ]] && echo "aviso: 'input text' no maneja bien no-ASCII; puede salir incompleto" >&2
            esc=${t// /%s}
            amctl_log input "input text (${#t} chars)"
            sh_exec "$AMCTL_MARKER_WAIT" input text "$esc" && echo "texto enviado (${#t} chars) [sesión rish]"
            ;;
        keyevent)
            local k="${1:-}" code=''
            [[ -z "$k" ]] && { echo "uso: amctl input keyevent CODIGO" >&2; return 2; }
            case "$k" in
                back) code=4 ;; home) code=3 ;; recents|app_switch) code=187 ;;
                enter) code=66 ;; del|backspace) code=67 ;; tab) code=61 ;;
                volume_up) code=24 ;; volume_down) code=25 ;; power) code=26 ;;
                *) num_arg "$k" code || { echo "amctl input keyevent: código o nombre desconocido" >&2; return 2; } ;;
            esac
            amctl_log input "input keyevent $code"
            sh_exec "$AMCTL_MARKER_WAIT" input keyevent "$code" && echo "keyevent $code [sesión rish]"
            ;;
    esac
}

