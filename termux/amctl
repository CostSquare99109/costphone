}

# ========================= batch =========================
# Ejecuta N órdenes en UN solo proceso (un solo exec de bash, una sola
# carga del script). Antes: "amctl a; amctl b; amctl c" = 3 execs de bash
# = ~450 ms solo de arranque, antes de que la primera orden salga.
#
#   amctl batch "launch com.whatsapp; waitfor Chats 8000; snap --filter chat"
#
BATCH_ARGV=()
batch_split() {
    local s="$1"
    local i=0 n cur="" q="" ch
    n=${#s}
    BATCH_ARGV=()
    while (( i < n )); do
        ch="${s:i:1}"
        if [[ -n "$q" ]]; then
            if [[ "$ch" == "$q" ]]; then q=""; else cur+="$ch"; fi
        elif [[ "$ch" == "'" || "$ch" == '"' ]]; then
            q="$ch"
        elif [[ "$ch" == " " || "$ch" == $'\t' ]]; then
            if [[ -n "$cur" ]]; then BATCH_ARGV+=("$cur"); cur=""; fi
        else
            cur+="$ch"
        fi
        (( i++ ))
    done
    [[ -n "$cur" ]] && BATCH_ARGV+=("$cur")
    return 0
}

cmd_batch() {
    local spec="$*"
    [[ -z "${spec//[[:space:]]/}" ]] && { echo "uso: amctl batch \"cmd1; cmd2; ...\"" >&2; return 2; }
    local -a items=()
    local part
    local IFS=';'
    # parte por ';' (sin romper los espacios de cada orden)
    local cur=""
    local i=0 ch
    for (( i=0; i<${#spec}; i++ )); do
        ch="${spec:i:1}"
        if [[ "$ch" == ";" ]]; then items+=("$cur"); cur=""; else cur+="$ch"; fi
    done
    items+=("$cur")
    unset IFS

    local outer_disp="$DISPLAY_ID"
    local it rc=0 first=1
    for it in "${items[@]}"; do
        # recorta espacios
        it="${it#"${it%%[![:space:]]*}"}"
        it="${it%"${it##*[![:space:]]}"}"
        [[ -z "$it" ]] && continue
        batch_split "$it"
        [[ ${#BATCH_ARGV[@]} -eq 0 ]] && continue
        DISPLAY_ID="$outer_disp"
        local -a av=("${BATCH_ARGV[@]}")
        parse_display "${av[@]}"
        av=(${POSITIONAL[@]+"${POSITIONAL[@]}"})
        [[ ${#av[@]} -eq 0 ]] && continue
        if [[ $first -eq 0 ]]; then echo "---"; fi
        first=0
        amctl_run "${av[@]}" || rc=1
    done
    return $rc
}

# ========================= dispatcher =========================
amctl_run() {
case "${1:-help}" in
    list)      cmd_list "${2:-}" ;;
    find)      cmd_find "${2:-}" ;;
    launch)    cmd_launch "${2:-}" ;;
    stop)      cmd_stop "${2:-}" ;;
    info)      cmd_info "${2:-}" ;;
    perms)     cmd_perms "${2:-}" ;;
    grant)     cmd_grant "${2:-}" "${3:-}" ;;
    revoke)    cmd_revoke "${2:-}" "${3:-}" ;;
    clear)     cmd_clear "${2:-}" ;;
    tree)      cmd_tree ;;
    snap)      shift; cmd_snap "$@" ;;
    tapref)    shift; cmd_tapref "$@" ;;
    waitfor)   shift; cmd_waitfor "$@" ;;
    tap)       cmd_tap "${2:-0}" "${3:-0}" "${4:-80}" ;;
    longpress) cmd_longpress "${2:-0}" "${3:-0}" "${4:-500}" ;;
    swipe)     cmd_swipe "${2:-0}" "${3:-0}" "${4:-0}" "${5:-0}" "${6:-300}" ;;
    scroll)    cmd_scroll "${2:-down}" "${3:-0}" "${4:-0}" ;;
    back)      cmd_back ;;
    home)      cmd_home ;;
    recents)   cmd_recents ;;
    float)     cmd_float "${2:-}" "${3:-}" "${4:-}" ;;
    type)      cmd_type "${2:-}" ;;
    cleartext) cmd_cleartext ;;
    paste)     cmd_paste ;;
    focus)     cmd_focus "${2:-}" ;;
    openurl)   cmd_openurl "${2:-}" "${3:-}" ;;
    tapshot)   cmd_tapshot "${2:-}" "${3:-}" "${4:-}" "${5:-}" ;;
    click)     cmd_click "${2:-}" ;;
    clickid)   cmd_clickid "${2:-}" ;;
    scrollto)  cmd_scrollto "${2:-}" ;;
    screenshot) shift; cmd_shot "$@" ;;
    shot)      shift; cmd_shot "$@" ;;
    see)       shift; cmd_shot "$@" ;;
    ocr)       shift; cmd_ocr "$@" ;;
    presskey)  cmd_presskey "${2:-}" ;;
    display)   shift; cmd_display "$@" ;;
    displays)  cmd_display status ;;
    batch)     shift; cmd_batch "$@" ;;
    warmup)    cmd_warmup ;;
    status)    cmd_status ;;
    enable)    cmd_enable ;;
    help|-h|--help)
        awk '/^#====/{c++; if(c==2) exit} c>=1{print}' "$0" | sed 's/^# \{0,1\}//' ;;
    *) echo "unknown command: $1 (use 'amctl help')" >&2; return 1 ;;
esac
}

parse_display "$@"
set -- ${POSITIONAL[@]+"${POSITIONAL[@]}"}
amctl_run "$@"
