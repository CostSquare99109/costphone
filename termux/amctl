# ---------- guard switch: toggled here, by the user, interactively ----------

cmd_guard_off() {
    if [[ ! -t 0 || ! -t 1 ]]; then
        amctl_log DENY "guard-off (sin terminal interactiva)"
        echo "amctl guard-off: solo desde una terminal interactiva." >&2
        return 5
    fi
    if [[ -f "$AMCTL_GUARD_OFF" ]]; then
        echo "la guardia ya estaba desactivada ($AMCTL_GUARD_OFF)"
        return 0
    fi
    {
        echo "════════ VAS A DESACTIVAR LA GUARDIA ════════"
        echo "La guardia impide tocar la pantalla mientras Termux está delante o"
        echo "la app en primer plano está en tu lista bloqueada, y bloquea todo"
        echo "cuando no se puede saber qué app es. Sin ella, cualquier toque o"
        echo "texto puede acabar en la terminal de Termux."
        echo "Escribe SI para desactivarla (cualquier otra cosa lo cancela)."
    }
    local ans=''
    read -r ans || ans=''
    if [[ "$ans" != SI ]]; then
        echo "cancelado: la guardia sigue activa"
        return 5
    fi
    mkdir -p "$AMCTL_DIR" || return 1
    : > "$AMCTL_GUARD_OFF" || return 1
    amctl_log guard "guardia desactivada por el usuario"
    echo "guardia desactivada. Reactívala con: amctl guard-on"
    return 0
}

cmd_guard_on() {
    if [[ -f "$AMCTL_GUARD_OFF" ]]; then
        rm -f "$AMCTL_GUARD_OFF"
        amctl_log guard "guardia reactivada por el usuario"
        echo "guardia activa"
    else
        echo "la guardia ya estaba activa"
    fi
    return 0
}

# ---------- full mode: enabled here, by the user, interactively ----------

cmd_full_on() {
    if [[ ! -t 0 || ! -t 1 ]]; then
        amctl_log DENY "full-on (sin terminal interactiva)"
        echo "amctl full-on: solo desde una terminal interactiva." >&2
        return 5
    fi
    if [[ "$AMCTL_MODE" != full ]]; then
        echo "amctl full-on: ejecútalo con AMCTL_MODE=full para activar el modo completo." >&2
        return 4
    fi
    if [[ -f "$AMCTL_ACK" ]]; then
        echo "modo full ya habilitado ($AMCTL_ACK)"
        return 0
    fi
    {
        echo "════════ VAS A HABILITAR EL MODO FULL ════════"
        echo "Con él, amctl puede ejecutar shell, pm, settings, force-stop y"
        echo "screenrecord con permisos de shell (uid 2000): puede tocar datos"
        echo "de otras apps, instalar o desinstalar paquetes y cambiar ajustes"
        echo "del sistema. Un agente con este modo puede romper el móvil."
        echo "Escribe SI para activarlo (cualquier otra cosa lo cancela)."
    }
    local ans=''
    read -r ans || ans=''
    if [[ "$ans" != SI ]]; then
        echo "cancelado: modo full no habilitado"
        return 5
    fi
    mkdir -p "$AMCTL_DIR" || return 1
    : > "$AMCTL_ACK" || return 1
    amctl_log full "modo full habilitado por el usuario"
    echo "modo full habilitado. El agente NO debe usar estos comandos."
    return 0
}

cmd_full_off() {
    if [[ -f "$AMCTL_ACK" ]]; then
        rm -f "$AMCTL_ACK"
        echo "modo full deshabilitado"
    else
        echo "el modo full ya estaba deshabilitado"
    fi
    return 0
}

# ---------- full mode only (user activated, never the agent) ----------

cmd_shell() {
    need_full "shell" || return $?
    need_session "shell" || return $?
    [[ $# -gt 0 ]] || { echo "uso: amctl shell CMD [args...]" >&2; return 2; }
    amctl_log shell "shell $*"
    sh_exec "$AMCTL_MARKER_WAIT" "$@" || return 1
    printf '%s\n' "$SESSION_OUT"
}

cmd_pm() {
    need_full "pm" || return $?
    need_session "pm" || return $?
    local sub="${1:-}"
    case "$sub" in
        list|install|uninstall|clear|grant|revoke|disable|enable|path|dump|reset-permissions) ;;
        *) echo "uso: amctl pm {list|install|uninstall|clear|grant|revoke|disable|enable|path|dump|reset-permissions} ..." >&2; return 2 ;;
    esac
    local a
    for a in "$@"; do
        [[ "$a" == -* || "$a" == +* ]] && continue
        [[ "$a" =~ $AMCTL_PKG_RE ]] && continue
        [[ "$a" == /sdcard/* || "$a" == *.apk ]] && continue
        [[ "$a" =~ ^[a-zA-Z0-9_.:@%+/=-]+$ ]] && continue
        echo "amctl pm: argumento no permitido: '$a'" >&2
        return 2
    done
    amctl_log pm "pm $*"
    guard_action pm || return $?
    sh_exec "$AMCTL_MARKER_WAIT" pm "$@" || return 1
    printf '%s\n' "$SESSION_OUT"
}

cmd_settings() {
    need_full "settings" || return $?
    need_session "settings" || return $?
    local sub="${1:-}" ns="${2:-}"
    case "$sub" in
        get|put|delete|list) ;;
        *) echo "uso: amctl settings {get|put|delete|list} {system|secure|global} ..." >&2; return 2 ;;
    esac
    case "$ns" in
        system|secure|global) ;;
        *) echo "amctl settings: namespace inválido (system|secure|global)" >&2; return 2 ;;
    esac
    local a
    for a in "$@"; do
        [[ "$a" =~ ^[a-zA-Z0-9_.:@%+/=-]+$ ]] || { echo "amctl settings: argumento no permitido: '$a'" >&2; return 2; }
    done
    amctl_log settings "settings $*"
    guard_action settings || return $?
    sh_exec "$AMCTL_MARKER_WAIT" settings "$@" || return 1
    printf '%s\n' "$SESSION_OUT"
}

cmd_am_force_stop() {
    need_full "am-force-stop" || return $?
    need_session "am-force-stop" || return $?
    [[ "${1:-}" =~ $AMCTL_PKG_RE ]] || { echo "amctl am-force-stop: uso: amctl am-force-stop <paquete>" >&2; return 2; }
    amctl_log am-force-stop "am force-stop $1"
    guard_action am-force-stop || return $?
    sh_exec "$AMCTL_MARKER_WAIT" am force-stop "$1" && echo "Stopped $1"
}

cmd_screenrecord() {
    need_full "screenrecord" || return $?
    need_session "screenrecord" || return $?
    local time=30 out=/sdcard/Download/amctl-record.mp4
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --time) num_arg "${2:-}" time || return 2; shift 2 || return 2 ;;
            --out) out="${2:-}"; shift 2 || return 2 ;;
            *) echo "amctl screenrecord: opción desconocida '$1'" >&2; return 2 ;;
        esac
    done
    (( time < 1 || time > 180 )) && { echo "amctl screenrecord: --time entre 1 y 180 s" >&2; return 2; }
    [[ "$out" =~ ^/sdcard/[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*\.mp4$ ]] || { echo "amctl screenrecord: salida debe ser /sdcard/... .mp4" >&2; return 2; }
    amctl_log screenrecord "screenrecord --time $time $out"
    sh_exec "$(( time + 15 ))" screenrecord --time "$time" "$out" && echo "grabado: $out (${time}s)"
}

# ========================= dispatcher =========================
case "${1:-help}" in
    input)      shift; cmd_input "$@" ;;
    screencap)  cmd_screencap "${2:-}" ;;
    shell)      shift; cmd_shell "$@" ;;
    pm)         shift; cmd_pm "$@" ;;
    settings)   shift; cmd_settings "$@" ;;
    am-force-stop) cmd_am_force_stop "${2:-}" ;;
    screenrecord) cmd_screenrecord "$@" ;;
    guard-off)  cmd_guard_off ;;
    guard-on)   cmd_guard_on ;;
    full-on)    cmd_full_on ;;
    full-off)   cmd_full_off ;;
    session-start) cmd_start ;;
    session-stop)  cmd_stop_session ;;
    status)        cmd_status ;;
    list)      cmd_list "${2:-}" ;;
    find)      cmd_find "${2:-}" ;;
    launch)    cmd_launch "${2:-}" ;;
    stop)      cmd_stop "${2:-}" ;;
    info)      cmd_info "${2:-}" ;;
    perms)     cmd_perms "${2:-}" ;;
    grant)     cmd_grant "${2:-}" "${3:-}" ;;
    revoke)    cmd_revoke "${2:-}" "${3:-}" ;;
    clear)     cmd_clear "${2:-}" ;;
    tree)      cmd_tree ;;
    snap)      shift; cmd_snap "$@" ;;
    tapref)    cmd_tapref "${2:-}" "${3:-}" ;;
    tap)       cmd_tap "${2:-}" "${3:-}" "${4:-80}" ;;
    longpress) cmd_longpress "${2:-0}" "${3:-0}" "${4:-500}" ;;
    swipe)     cmd_swipe "${2:-0}" "${3:-0}" "${4:-0}" "${5:-0}" "${6:-300}" ;;
    scroll)    cmd_scroll "${2:-down}" "${3:-0}" "${4:-0}" ;;
    back)      cmd_back ;;
    home)      cmd_home ;;
    recents)   cmd_recents ;;
    float)     cmd_float "${2:-}" "${3:-}" "${4:-}" ;;
    type)      cmd_type "${2:-}" ;;
    cleartext) cmd_cleartext ;;
    paste)     cmd_paste ;;
    focus)     cmd_focus "${2:-}" ;;
    openurl)   cmd_openurl "${2:-}" ;;
    tapshot)   cmd_tapshot "${2:-}" "${3:-}" "${4:-}" "${5:-}" ;;
    click)     cmd_click "${2:-}" ;;
    clickid)   cmd_clickid "${2:-}" ;;
    scrollto)  cmd_scrollto "${2:-}" ;;
    screenshot) cmd_shot "${2:-}" ;;
    shot)      cmd_shot "${2:-}" ;;
    see)       cmd_shot "${2:-}" ;;
    presskey)  cmd_presskey "${2:-}" ;;
    help|-h|--help)
        awk '/^#====/{c++; if(c==2) exit} c>=1{print}' "$0" | sed 's/^# \{0,1\}//' ;;
    *) echo "unknown command: $1 (use 'amctl help')" >&2; exit 1 ;;
esac
